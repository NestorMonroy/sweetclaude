# SweetClaude coverage configuration (ISSUE-254)
#
# Without an explicit source scope, pytest tmp fixtures that copy scripts/ into
# a temporary project directory are measured as if they were repo files. That
# moves the denominator with the test suite and makes any gate meaningless.

[run]
source = scripts
branch = false
# Tests drive several scripts as subprocesses, because that is the interface
# the skills actually use. Collecting coverage from a subprocess requires
# parallel mode plus a combine step, which pytest-cov performs automatically.
# With parallel = false those files measure 0% on any machine whose site
# packages differ, which is how an 80% gate calibrated locally failed CI at
# 68% (ISSUE-254 follow-up).
parallel = true

omit =
    */__pycache__/*
    */.venv/*
    */site-packages/*
    # pytest tmp fixture projects — copies of scripts/, not the real tree
    /private/var/folders/*
    /tmp/*
    */pytest-of-*/*

[report]
# Gate, calibrated against a CI checkout — not a developer machine.
#
# Much of this repo's local coverage comes from tests reading live
# .sweetclaude project data, which is gitignored and therefore absent in CI.
# Hiding it locally reproduces CI's skip count (36 vs 37) and drops coverage
# from 81% to 79.9%. The 80 gate was calibrated on a developer machine and
# failed CI at 68%; a gate that only one environment can meet measures the
# environment, not the code.
fail_under = 78
precision = 0
show_missing = true
skip_covered = false
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
    if TYPE_CHECKING:

[html]
directory = htmlcov
